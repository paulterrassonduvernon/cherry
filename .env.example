# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit real secrets.

# --- Synthesis provider ---
# One of: claude | ollama
# "claude" needs internet + ANTHROPIC_API_KEY below.
# "ollama" runs 100% locally against a running Ollama server — no data ever
# leaves the machine, but quality depends on the local model.
SYNTHESIS_PROVIDER=claude

# --- Claude API (only used if SYNTHESIS_PROVIDER=claude; audio never transits, only transcribed text) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Ollama (only used if SYNTHESIS_PROVIDER=ollama) ---
# Install: https://ollama.com — then `ollama pull llama3.1` and `ollama serve`.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Synthesis scheduling ---
# Cron expression for the automatic "resynthesis" job (default: weekly, Sunday 23:00)
SYNTHESIS_CRON=0 23 * * 0

# --- Local Whisper transcription (voice capture) ---
# One of: tiny | base | small — set up via `npm run setup:whisper`
# (clones + builds whisper.cpp into vendor/whisper.cpp and downloads the model).
WHISPER_MODEL_SIZE=base
# Override only if you installed whisper.cpp somewhere else (e.g. Homebrew):
# WHISPER_BINARY_PATH=/opt/homebrew/bin/whisper-cli
# WHISPER_MODEL_PATH=/opt/homebrew/share/whisper.cpp/ggml-base.bin
FFMPEG_PATH=ffmpeg

# --- Server ---
PORT=3001

# --- Paths (relative to repo root) ---
DATA_DIR=./data
