# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit real secrets.

# --- Claude API (used for auto-tagging & synthesis only; audio never leaves the machine) ---
ANTHROPIC_API_KEY=

# Model used for synthesis / auto-tagging
ANTHROPIC_MODEL=claude-sonnet-5

# --- Local Whisper transcription ---
# One of: tiny | base | small
WHISPER_MODEL_SIZE=base

# --- Synthesis scheduling ---
# Cron expression for the automatic "resynthesis" job (default: weekly, Sunday 23:00)
SYNTHESIS_CRON=0 23 * * 0

# --- Server ---
PORT=3001

# --- Paths (relative to repo root) ---
DATA_DIR=./data
